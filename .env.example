# =====================================================================
#  Copy this file to `.env` (same folder) and fill what you need.
#  Everything works with just the BRAND_* block + DRY_RUN=true.
# =====================================================================

# ---------- App ----------
APP_TIMEZONE=Asia/Kolkata
# true  = SIMULATE publishing (safe, nothing is posted)
# false = really post to LinkedIn / Instagram
DRY_RUN=true
# Public URL of THIS backend. Instagram downloads your image from here, so for
# real Instagram posting it must be reachable from the internet
# (e.g. a free cloudflared / ngrok tunnel URL). Not needed for LinkedIn.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Customer / brand profile (used in every AI prompt) ----------
BRAND_NAME=Acme Studio
BRAND_WEBSITE=https://acme.example
BRAND_INDUSTRY=Digital marketing agency
BRAND_DESCRIPTION=We help local businesses get more customers with simple, honest marketing.
BRAND_AUDIENCE=Small business owners and founders who are new to online marketing
BRAND_VOICE=friendly, practical, confident, no jargon
BRAND_LANGUAGE=English
# SEO keywords the AI must weave in and the SEO checker looks for (comma separated)
BRAND_KEYWORDS=social media marketing,small business marketing,content calendar,lead generation
# Default hashtags (comma separated, no # needed)
BRAND_HASHTAGS=socialmediamarketing,smallbusiness,contentmarketing,digitalmarketing
BRAND_CTA=Book a free 15-minute strategy call - link in bio.
# Real facts the AI may use (prices, packages, process). It must not invent others. Separate with " | ".
# NOTE: in .env an unquoted " #" starts a comment, so avoid "#" inside values.
BRAND_FACTS=We offer 3 packages starting at Rs 5,000 | Free 15-minute strategy call | Reply within one working day
# Things the AI must never say or do. Separate with " | ".
BRAND_AVOID=Never promise guaranteed results | Never invent clients, testimonials or statistics
# Themes the AI rotates through when planning (use | to separate)
CONTENT_PILLARS=Quick tips|Client stories|Myths debunked|Behind the scenes

# ---------- Posting rhythm (auto-plan uses this) ----------
POSTING_TIMES=09:30,18:00
POSTING_DAYS=mon,wed,fri
# Platforms ticked by default on new posts and Auto-plan (you can change per post).
DEFAULT_PLATFORMS=linkedin,instagram
# When you press Post now (or a scheduled time arrives) and the post has no text / no image, create them automatically.
AUTO_WRITE=true
AUTO_IMAGE=true

# ---------- Custom prompts ----------
# Leave empty to use backend/prompts/post.md and ideas.md (recommended: edit those files).
# Or paste a full prompt here on ONE line (use \n for new lines). Placeholders: {{brand_name}},
# {{brand_voice}}, {{brand_keywords}}, {{topic}}, {{extra}}, {{platforms}} ... see prompts/post.md
POST_PROMPT=
IDEAS_PROMPT=

# ---------- OpenRouter (text AI - free models) ----------
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Tried in order. "openrouter/free" auto-picks any available free model.
OPENROUTER_TEXT_MODELS=openrouter/free,google/gemma-4-31b-it:free

# ---------- Images ----------
# pollinations = free, no key (default) | openrouter = uses OPENROUTER_IMAGE_MODEL (not free) | none
IMAGE_PROVIDER=pollinations
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
IMAGE_STYLE=clean modern editorial illustration, soft lighting, vibrant but minimal colours, no text, no logos
# Small headline drawn on every generated photo (the AI writes it with the post; you can edit it per post).
# The picture itself stays text-free because image AIs misspell words; the caption is added afterwards.
IMAGE_CAPTION=true
IMAGE_CAPTION_POSITION=bottom
# Tiny label under the caption: auto = your BRAND_NAME, leave empty for none
IMAGE_BRAND_TAG=auto
# NOTE: in .env a " #" inside a value starts a comment, so keep the colour as the only thing on its line
IMAGE_ACCENT=#7c7ff7

# ---------- "Connect" buttons (recommended: no copy-pasting tokens) ----------
# Fill the client id/secret of YOUR app, restart the API, then press Connect in "Brand & setup".
# Register this exact redirect URL in each app:
#   LinkedIn:  http://localhost:8000/api/oauth/linkedin/callback
#   Meta:      http://localhost:8000/api/oauth/instagram/callback
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:8000
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement

# ---------- LinkedIn (free: https://developer.linkedin.com -> create app -> "Share on LinkedIn") ----------
# (Only needed if you are NOT using the Connect button.)
# Token scopes needed: w_member_social (+ openid profile so the author id is auto-detected). Tokens last ~60 days.
LINKEDIN_ACCESS_TOKEN=
# Optional. urn:li:person:xxxx or urn:li:organization:xxxx (company page needs w_organization_social)
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202606

# ---------- Instagram (Graph API, free) ----------
# Needs an Instagram Business/Creator account linked to a Facebook Page, and a Meta app with
# instagram_content_publish permission. See README.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
GRAPH_API_VERSION=v23.0
